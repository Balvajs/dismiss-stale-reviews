{
  "name": "dismiss-stale-reviews",
  "version": "1.0.0",
  "keywords": [
    "actions"
  ],
  "license": "MIT",
  "author": "Balvajs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Balvajs/dismiss-stale-reviews.git"
  },
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "type-check": "tsc",
    "format": "oxfmt -c oxfmt.config.ts",
    "format-check": "oxfmt --check -c oxfmt.config.ts",
    "lint": "oxlint -c oxlint.config.ts",
    "package": "tsup src/main.ts --clean",
    "test": "vitest run --passWithNoTests",
    "generate": "graphql-codegen-esm --config codegen.ts",
    "all": "bun run type-check && bun run format-check && bun run lint && bun run package",
    "semantic-release": "semantic-release",
    "prepare": "husky"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@graphql-codegen/add": "7.1.0",
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/near-operation-file-preset": "5.2.1",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.2",
    "@octokit/action": "8.0.4",
    "@octokit/core": "7.0.6",
    "@octokit/graphql": "9.0.3",
    "@octokit/graphql-schema": "15.26.1",
    "@octokit/plugin-paginate-graphql": "6.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "24.13.3",
    "chalk": "5.6.2",
    "codeowners": "5.1.1",
    "graphql": "16.14.2",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "minimatch": "10.2.5",
    "node-fetch": "3.3.2",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "radashi": "12.9.1",
    "semantic-release": "25.0.8",
    "semantic-release-major-tag": "0.3.2",
    "simple-git": "3.36.0",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@octokit/core": "$@octokit/core"
  },
  "engines": {
    "node": "=24"
  },
  "packageManager": "bun@1.3.12"
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "mergeConfidence:all-badges"],
  "minor": {
    "automerge": true
  },
  "patch": {
    "automerge": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "/^24\\..*$/"
    },
    {
      "description": "keep the node version in mise.toml and engines in sync",
      "matchDepNames": ["node"],
      "groupName": "node"
    },
    {
      "description": "keep the bun version in mise.toml and packageManager in sync",
      "matchDepNames": ["bun"],
      "groupName": "bun"
    },
    {
      "matchManagers": ["npm"],
      "postUpgradeTasks": {
        "commands": ["bun install", "bun generate", "bun package"],
        "fileFilters": ["src/**/*", "dist/**/*"],
        "executionMode": "branch"
      }
    }
  ]
}

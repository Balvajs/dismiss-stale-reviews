{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "mergeConfidence:all-badges"],
  "minor": {
    "automerge": true
  },
  "patch": {
    "automerge": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "/^24\\..*$/"
    },
    {
      "description": "keep the node version in mise.toml and engines in sync",
      "matchDepNames": ["node"],
      "groupName": "node"
    },
    {
      "description": "keep the bun version in mise.toml and packageManager in sync",
      "matchDepNames": ["bun"],
      "groupName": "bun"
    },
    {
      "description": "oxlint-tsgolint embeds the TS compiler and declares no peer dep on it",
      "matchDepNames": ["typescript", "oxlint-tsgolint"],
      "groupName": "typescript"
    },
    {
      "description": "oxfmt is pre-1.0, a minor can reformat every file in the repo",
      "matchDepNames": ["oxfmt"],
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "postUpgradeTasks": {
        "commands": ["bun install", "bun generate", "bun package"],
        "fileFilters": ["src/**/*", "dist/**/*"],
        "executionMode": "branch"
      }
    }
  ]
}

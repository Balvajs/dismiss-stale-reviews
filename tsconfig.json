{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "outDir": "./lib",
    "rootDir": "./",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "noImplicitReturns": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules", "dist"]
}
